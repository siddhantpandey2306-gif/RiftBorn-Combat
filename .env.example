# RIFTBORN Environment Variables Template
# Copy this file to .env.local or set these in your hosting environment (e.g. GitHub Pages secrets / Vite)
# NEVER put your Supabase service_role key here. Use ONLY the publishable "anon" key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
